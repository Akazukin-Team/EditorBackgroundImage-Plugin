<idea-plugin require-restart="false">
    <id>org.akazukin.editorBackgroundImage</id>
    <name>${name}</name>
    <version>${version}</version>
    <vendor
            email="akazukin.team+intellij-background@gmail.com"
            url="${url}">
        ${vendor}
    </vendor>

    <description><![CDATA[
      Set the editor background to a random picture from a folder or selected picture.
    ]]></description>

    <change-notes>
        <![CDATA[
            <html>
                <a target="_blank" href="https://github.com/Akazukin-Team/EditorBackgroundImage-Plugin/compare/7.1.0...7.2.0"><h2>7.2.0</a>
                <ul>
                    <li>Add a shortcut for toggling auto background switch</li>
                    <li>Add a shortcut for reloading background images</li>
                </ul>
            </html>
        ]]>
    </change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true">intellij.webp</depends>


    <applicationListeners>
        <listener class="org.akazukin.intellij.background.listener.DynamicPluginListenerImpl"
                  topic="com.intellij.ide.plugins.DynamicPluginListener"/>
        <listener class="org.akazukin.intellij.background.listener.WebpDynamicPluginListenerImpl"
                  topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>


    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="org.akazukin.intellij.background.listener.ProjectActivityImpl"/>

        <applicationConfigurable groupId="appearance" groupWeight="20" id="editor.background.image"
                                 displayName="Editor Background Image"
                                 instance="org.akazukin.intellij.background.settings.Settings"/>

        <applicationService serviceImplementation="org.akazukin.intellij.background.settings.Config"/>
    </extensions>


    <actions>
        <action id="randomBackgroundImage"
                class="org.akazukin.intellij.background.actions.SetBackgroundAction"
                text="Set Background To Random Image">
            <keyboard-shortcut keymap="$default" first-keystroke="control shift W" os="windows"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control shift W" os="linux"/>
            <keyboard-shortcut keymap="$default" first-keystroke="meta shift W" os="mac"/>
        </action>

        <action id="clearBackgroundImage"
                class="org.akazukin.intellij.background.actions.ClearBackgroundAction"
                text="Clear Background Image"/>

        <action id="cacheBackgroundImage"
                class="org.akazukin.intellij.background.actions.CacheBackgroundImagesAction"
                text="Cache Background Images"/>

        <action id="toggleAutoSwitch"
                class="org.akazukin.intellij.background.actions.ToggleAutoSwitchAction"
                text="Toggle Automatic Wallpaper Switching">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt W" os="windows"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt W" os="linux"/>
            <keyboard-shortcut keymap="$default" first-keystroke="meta alt W" os="mac"/>
        </action>

        <action id="cacheAndReloadBackgroundImage"
                class="org.akazukin.intellij.background.actions.CacheAndReloadBackgroundAction"
                text="Cache the background images and set a random image">
            <keyboard-shortcut keymap="$default" first-keystroke="control shift W" os="windows"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control shift W" os="linux"/>
            <keyboard-shortcut keymap="$default" first-keystroke="meta shift W" os="mac"/>
        </action>

        <group id="editorBackgroundImage" text="Editor Background Image" description="Editor Background Image"
               popup="true">
            <reference ref="randomBackgroundImage"/>
            <reference ref="clearBackgroundImage"/>
            <reference ref="cacheBackgroundImage"/>
            <reference ref="toggleAutoSwitch"/>
            <reference ref="cacheAndReloadBackgroundImage"/>
            <add-to-group group-id="ViewMenu" anchor="last"/>
        </group>
    </actions>

</idea-plugin>
